{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afwi-kai.example/schemas/squadrons-digital-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "normative", "ruleCoreVersion", "sourceSet", "scopeStatus", "componentIds", "components", "activationContract"],
  "properties": {
    "schemaVersion": {"const": "0.1.0-candidate"},
    "normative": {"const": false},
    "ruleCoreVersion": {"type": "string"},
    "sourceSet": {"type": "string"},
    "scopeStatus": {"const": "partial"},
    "componentIds": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"pattern": "^COMP-SQUADRON-"}},
    "components": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}},
    "activationContract": {"type": "object", "required": ["status", "reason", "ruleVectorIds", "approvedBy", "approvedAt"], "properties": {"status": {"const": "approved"}, "reason": {"type": "string"}, "ruleVectorIds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"pattern": "^RV-SQUADRON-"}}, "approvedBy": {"const": "ルール所有者"}, "approvedAt": {"const": "2026-09-26"}}}
  }
}
