{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afwi-kai.example/schemas/source-set-snapshot.schema.json",
  "title": "AFWI-KAI source set snapshot",
  "type": "object",
  "required": ["schema_version", "source_set_id", "status", "captured_at", "source_root", "aggregate_sha256", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "source_set_id": { "type": "string", "pattern": "^SRCSET-[A-Z0-9-]+$" },
    "status": { "enum": ["provisional", "approved"] },
    "captured_at": { "type": "string" },
    "source_root": { "const": "sources/" },
    "aggregate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "content_sha256"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string" },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
