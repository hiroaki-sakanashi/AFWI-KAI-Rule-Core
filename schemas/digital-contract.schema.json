{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afwi-kai.example/schemas/digital-contract.schema.json",
  "title": "AFWI-KAI EMI Digital candidate contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "digitalContractVersion", "ruleCoreVersion", "sourceSet", "artifactStatus", "componentIds", "components", "ruleVectorSet"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "digitalContractVersion": { "const": "0.1.0-candidate" },
    "ruleCoreVersion": { "type": "string" },
    "sourceSet": { "type": "string" },
    "artifactStatus": { "const": "candidate" },
    "componentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^COMP-EMI-(BLUE|RED)$" }
    },
    "components": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object" } },
    "ruleVectorSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedStatus", "approvedBy", "approvedAt", "approvedVectorIds", "candidateVectorIds"],
      "properties": {
        "approvedStatus": { "const": "approved" },
        "approvedBy": { "const": "ルール所有者" },
        "approvedAt": { "const": "2026-09-23" },
        "approvedVectorIds": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "candidateVectorIds": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
