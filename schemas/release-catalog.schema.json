{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afwi-kai.example/schemas/release-catalog.schema.json",
  "title": "AFWI-KAI Rule Core Release Catalog",
  "description": "不変release manifestを可変aliasとappend-only status recordから参照するRelease Catalog Schema。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "latest_stable", "latest_preview_or_rc", "previous_releases", "withdrawn", "status_records"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated_at": { "type": "string", "format": "date-time" },
    "latest_stable": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/releasePointer" }] },
    "latest_preview_or_rc": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/releasePointer" }] },
    "previous_releases": {
      "type": "array",
      "items": { "$ref": "#/$defs/releasePointer" },
      "uniqueItems": true
    },
    "withdrawn": {
      "type": "array",
      "items": { "$ref": "#/$defs/withdrawnRecord" },
      "uniqueItems": true
    },
    "status_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/statusRecord" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "releaseId": { "type": "string", "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" },
    "releasePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "issued_status", "current_status", "manifest_path", "manifest_hash_profile", "manifest_content_kind", "manifest_media_type", "manifest_sha256", "content_commit", "git_tag"],
      "properties": {
        "release_id": { "$ref": "#/$defs/releaseId" },
        "issued_status": { "enum": ["preview", "release-candidate", "stable"] },
        "current_status": { "enum": ["preview", "release-candidate", "stable", "superseded", "withdrawn"] },
        "manifest_path": { "type": "string", "minLength": 1 },
        "manifest_hash_profile": { "const": "afwi-content-sha256-v1" },
        "manifest_content_kind": { "const": "text" },
        "manifest_media_type": { "const": "application/json" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "content_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_tag": { "type": "string", "minLength": 1 },
        "supersedes": { "type": ["string", "null"], "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" },
        "content_equivalent_to": { "type": ["string", "null"], "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" }
      }
    },
    "statusRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "release_id", "previous_status", "new_status", "recorded_at", "reason", "approved_by"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "release_id": { "$ref": "#/$defs/releaseId" },
        "previous_status": { "enum": ["preview", "release-candidate", "stable", "superseded", "withdrawn"] },
        "new_status": { "enum": ["preview", "release-candidate", "stable", "superseded", "withdrawn"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "replacement_release_id": { "type": ["string", "null"], "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" }
      }
    },
    "withdrawnRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "issued_status", "current_status", "manifest_path", "manifest_hash_profile", "manifest_content_kind", "manifest_media_type", "manifest_sha256", "content_commit", "git_tag", "withdrawal_notice"],
      "properties": {
        "release_id": { "$ref": "#/$defs/releaseId" },
        "issued_status": { "enum": ["preview", "release-candidate", "stable"] },
        "current_status": { "const": "withdrawn" },
        "manifest_path": { "type": "string", "minLength": 1 },
        "manifest_hash_profile": { "const": "afwi-content-sha256-v1" },
        "manifest_content_kind": { "const": "text" },
        "manifest_media_type": { "const": "application/json" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "content_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_tag": { "type": "string", "minLength": 1 },
        "supersedes": { "type": ["string", "null"], "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" },
        "content_equivalent_to": { "type": ["string", "null"], "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" },
        "withdrawal_notice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "effective_at", "recommended_replacement"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "effective_at": { "type": "string", "format": "date-time" },
            "recommended_replacement": { "type": ["string", "null"], "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" }
          }
        }
      }
    }
  }
}
