{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afwi-kai.example/schemas/rights-clearance-record.schema.json",
  "title": "AFWI-KAI append-only rights clearance record",
  "description": "A rights record supplements but never rewrites a frozen Rule Core Release Manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_status",
    "release_id",
    "manifest_hash",
    "content_commit",
    "decision_date",
    "approved_by",
    "normative_content_changed",
    "cleared_for_public_distribution",
    "still_restricted",
    "issue_updates"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_id": { "type": "string", "pattern": "^RIGHTS-RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "record_status": { "enum": ["proposal", "approved", "superseded"] },
    "release_id": { "type": "string", "pattern": "^RC-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]{2}$" },
    "manifest_hash": { "$ref": "#/$defs/contentHash" },
    "content_commit": { "$ref": "#/$defs/gitCommit" },
    "decision_date": { "type": ["string", "null"], "format": "date" },
    "approved_by": { "type": ["string", "null"], "minLength": 1 },
    "normative_content_changed": { "const": false },
    "previous_rights_record": { "type": ["string", "null"] },
    "decision_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathHashReference" },
      "uniqueItems": true
    },
    "cleared_for_public_distribution": {
      "type": "array",
      "items": { "$ref": "#/$defs/clearanceItem" },
      "uniqueItems": true
    },
    "still_restricted": {
      "type": "array",
      "items": { "$ref": "#/$defs/restrictionItem" },
      "uniqueItems": true
    },
    "issue_updates": {
      "type": "array",
      "items": { "$ref": "#/$defs/issueUpdate" },
      "uniqueItems": true
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "record_status": { "const": "approved" } }, "required": ["record_status"] },
      "then": {
        "properties": {
          "decision_date": { "type": "string", "format": "date" },
          "approved_by": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_profile", "content_kind", "media_type", "sha256"],
      "properties": {
        "hash_profile": { "const": "afwi-content-sha256-v1" },
        "content_kind": { "const": "text" },
        "media_type": { "const": "application/json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pathHashReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/genericContentHash" }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_class", "release_manifest_classification"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifact_class": { "type": "string", "minLength": 1 },
        "release_manifest_classification": { "enum": ["public", "developer-only", "internal archive", "rights-pending", "not-in-frozen-manifest"] },
        "artifact_hash": { "$ref": "#/$defs/genericContentHash" }
      }
    },
    "clearanceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "artifact_class", "release_manifest_classification", "clearance_basis",
        "public_distribution_allowed", "raw_source_included"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifact_class": { "type": "string", "minLength": 1 },
        "release_manifest_classification": { "enum": ["public", "developer-only", "internal archive", "rights-pending", "not-in-frozen-manifest"] },
        "artifact_hash": { "$ref": "#/$defs/genericContentHash" },
        "clearance_basis": { "type": "string", "minLength": 1 },
        "public_distribution_allowed": { "const": true },
        "raw_source_included": { "const": false },
        "license_reference": { "type": ["string", "null"] }
      }
    },
    "restrictionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "artifact_class", "release_manifest_classification", "restriction_scope",
        "reason", "public_distribution_allowed"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifact_class": { "type": "string", "minLength": 1 },
        "release_manifest_classification": { "enum": ["public", "developer-only", "internal archive", "rights-pending", "not-in-frozen-manifest"] },
        "artifact_hash": { "$ref": "#/$defs/genericContentHash" },
        "restriction_scope": { "enum": ["raw-source", "image-pixels", "third-party-material", "other"] },
        "reason": { "type": "string", "minLength": 1 },
        "public_distribution_allowed": { "const": false }
      }
    },
    "genericContentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_profile", "content_kind", "media_type", "sha256"],
      "properties": {
        "hash_profile": { "enum": ["afwi-content-sha256-v1", "canonical-text-v1", "raw-binary-v1"] },
        "content_kind": { "enum": ["text", "binary"] },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "issueUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "previous_scope", "new_scope", "resolution_status"],
      "properties": {
        "issue_id": { "type": "string", "minLength": 1 },
        "previous_scope": { "type": "string", "minLength": 1 },
        "new_scope": { "type": "string", "minLength": 1 },
        "resolution_status": { "enum": ["open_scope_narrowed", "resolved", "unchanged"] }
      }
    }
  }
}
